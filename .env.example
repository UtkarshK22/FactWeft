# FactWeft configuration. Copy to .env for local runs: cp .env.example .env
# Docker Compose reads this file for ${VAR:-default} interpolation.

# --- FalkorDB (the only memory store; there is no fallback) ---
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# Required by docker-compose (REDIS_ARGS --requirepass). Local demos only.
FALKORDB_PASSWORD=factweft_dev_pw

# --- LLM: fixture = offline canned JSON, live = real provider ---
LLM_MODE=fixture
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# --- App ---
DEMO_MODE=true
TOKENS_FILE=demo_data/tokens.json
CORS_ORIGINS=http://localhost:5173
QUERY_TIMEOUT_MS=5000
MAX_GRAPH_NODES=500
TRACE_BUFFER_SIZE=500
